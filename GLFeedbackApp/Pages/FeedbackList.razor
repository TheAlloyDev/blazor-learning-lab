@page "/feedback/list"
@using GLFeedbackApp.Models
@using GLFeedbackApp.Services
@inject FeedbackService FeedbackService

<h3>Feedback Submission</h3>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Comment</th>
        </tr>
    </thead>
    <tbody>
        @if (feedbackListItems.Any())
        {
            @foreach (var feedback in feedbackListItems)
            {
                <tr>
                    <td>@feedback.Name</td>
                    <td>@feedback.Email</td>
                    <td>@feedback.Comment</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3">No feedback has been submitted yet.</td>
            </tr>
        }
    </tbody>
</table>

<p>
    <NavLink href="/feedback">Back to Feedback Form</NavLink>
</p>

@code {
    private List<Feedback> feedbackListItems = [];

    protected override async Task OnInitializedAsync()
    {
        feedbackListItems = await FeedbackService.GetFeedbackAsync();
    }
}



