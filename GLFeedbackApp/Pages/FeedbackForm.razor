@page "/feedback"
@using System.Threading.Tasks
@using GLFeedbackApp.Models
@using GLFeedbackApp.Services
@inject FeedbackService FeedbackService
@inject NavigationManager NavigationManager

<PageTitle>Feedback Form</PageTitle>

<h1>Feedback Form</h1>

@* This form binds directly to the `feedback` object declared in the @code block. *@
<EditForm Model="feedback" OnValidSubmit="HandleSubmit">
    @* Enables validation based on attributes defined on the Feedback model. *@
    <DataAnnotationsValidator />
    @* Displays a summary of any validation errors for the whole form. *@
    <ValidationSummary />

    <div>
        <label for="name">Name</label>
        <InputText id="name" @bind-Value="feedback.Name" class="form-control" />
        <ValidationMessage For="@(() => feedback.Name)" />
    </div>

    <div>
        <label for="email">Email</label>
        <InputText id="email" class="form-control" @bind-Value="feedback.Email" />
        <ValidationMessage For="@(() => feedback.Email)" />
    </div>

    <div>
        <label for="comment">Comment</label>
        <InputTextArea id="comment" class="form-control" @bind-Value="feedback.Comment" />
    </div>

    <button type="submit" class="btn btn-primary">Submit Feedback</button>
</EditForm>

@if (isSubmitted)
{
    <p>Thank you for your feedback!</p>
}

@code {
    // Holds the current values the user is typing into the form.
    private Feedback feedback = new();

    // Runs after the form passes validation. Saves the entry, clears the form,
    // and redirects to the page that shows submitted feedback.
    private bool isSubmitted = false;

    private async Task HandleSubmit()
    {
        await FeedbackService.AddFeedbackAsync(feedback);
        Console.WriteLine("Feedback submitted: " + feedback.Name);
        feedback = new Feedback();
        isSubmitted = true;
        NavigationManager.NavigateTo("/feedback/list");
    }
}