@page "/addrecipe"
@inject NavigationManager NavManager

<PageTitle>Add Recipe</PageTitle>

<h1>Add Recipe</h1>

<EditForm Model="NewRecipe" OnValidSubmit="SubmitRecipe">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="recipe-name">Recipe Name</label>
        <InputText id="recipe-name" class="form-control" @bind-Value="NewRecipe.Name" />
    </div>

    <div class="mb-3">
        <label for="recipe-description">Recipe Description</label>
        <InputTextArea id="recipe-description" class="form-control" @bind-Value="NewRecipe.Description" />
    </div>

    <button type="submit" class="btn btn-primary">Submit</button>
</EditForm>

<p>
    <NavLink href="/home">Back to Recipes</NavLink>
</p>

@code {
    private Recipe NewRecipe { get; } = new();

    private void SubmitRecipe()
    {
        var nextId = RecipeStore.Recipes.Count == 0 ? 1 : RecipeStore.Recipes.Max(recipe => recipe.Id) + 1;

        RecipeStore.Recipes.Add(new Recipe
        {
            Id = nextId,
            Name = NewRecipe.Name,
            Description = NewRecipe.Description
        });

        NewRecipe.Name = string.Empty;
        NewRecipe.Description = string.Empty;

        NavManager.NavigateTo("/home");
    }
}